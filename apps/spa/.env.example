
# --- ERC-4337 (Phase 0). Absent = app runs the legacy embedded-key path. ---
# Bundler(s): comma-separated for fallback. A bundler is a chokepoint operated
# by someone else, so list more than one and aim to self-host (`alto`) for
# production — a refused UserOperation never reaches the chain.
# NEXT_PUBLIC_BUNDLER_URL=https://api.pimlico.io/v2/84532/rpc?apikey=YOUR_KEY
# Sponsorship. Omit to keep accounts working with the user funding their own gas.
# NEXT_PUBLIC_PAYMASTER_URL=https://api.pimlico.io/v2/84532/rpc?apikey=YOUR_KEY

# PurchaseInsurance (Base Sepolia)
# NEXT_PUBLIC_PURCHASE_INSURANCE_ADDRESS=0x65Dd4cc78bE179CFEe624c221d30b5b06fC65cF4
