{
  "name": "@dovizir/indexer",
  "version": "0.1.0",
  "description": "Dovizir off-chain indexer: syncs M1 contract events into SQLite and serves derived Sarraf/member state, computed (dormant) credit rates, an offline-note pending-serials feed, and act-2 yardstick P&L over a Fastify REST API.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "sync": "tsx src/sync-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dovizir/sdk": "workspace:*",
    "@fastify/cors": "^9.0.1",
    "better-sqlite3": "^11.3.0",
    "fastify": "^4.27.0",
    "viem": "^2.9.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
