index a8869d5..a8e107b 100644
--- a/packages/acceptance/src/arm/ArmBDeployer.sol
+++ b/packages/acceptance/src/arm/ArmBDeployer.sol
@@ -1,5 +1,52 @@
 // SPDX-License-Identifier: MIT
 pragma solidity ^0.8.24;
-import {StubDeployer} from "../StubDeployer.sol";
-/// Arm B deployer — brew replaces this stub inheritance with the real system.
-contract ArmBDeployer is StubDeployer {}
+
+import {IAcceptanceDeployer, IMockUsdt, DovizirSystem} from "../interfaces/IAcceptanceDeployer.sol";
+import {
+    IIouToken,
+    IMemberRegistry,
+    IReservePool,
+    IInsuranceFund,
+    ISarrafRegistry,
+    INoteVault
+} from "../interfaces/IDovizir.sol";
+
+import {MockUsdt} from "../../../contracts/src/armb/MockUsdt.sol";
+import {IouToken} from "../../../contracts/src/armb/IouToken.sol";
+import {SarrafRegistry} from "../../../contracts/src/armb/SarrafRegistry.sol";
+import {MemberRegistry} from "../../../contracts/src/armb/MemberRegistry.sol";
+import {InsuranceFund} from "../../../contracts/src/armb/InsuranceFund.sol";
+import {ReservePool} from "../../../contracts/src/armb/ReservePool.sol";
+import {NoteVault} from "../../../contracts/src/armb/NoteVault.sol";
+
+/// Arm B deployer. Stateless: every deploy() call creates a fresh, disjoint
+/// set of six contracts and wires them, then drops all deployer-side
+/// privilege before returning (each contract locks its wiring setter after
+/// one use).
+contract ArmBDeployer is IAcceptanceDeployer {
+    function deploy() external override returns (DovizirSystem memory system) {
+        MockUsdt usdt = new MockUsdt();
+        IouToken iou = new IouToken();
+        SarrafRegistry sarrafRegistry = new SarrafRegistry();
+        MemberRegistry memberRegistry = new MemberRegistry(address(sarrafRegistry));
+        InsuranceFund fund = new InsuranceFund(address(usdt));
+        ReservePool pool =
+            new ReservePool(address(usdt), address(iou), address(sarrafRegistry), address(fund));
+        NoteVault vault = new NoteVault(address(iou));
+
+        sarrafRegistry.setReservePool(address(pool));
+        memberRegistry.setReservePool(address(pool));
+        iou.setMinters(address(pool), address(vault));
+        fund.setAuthorized(address(pool), address(vault));
+
+        system = DovizirSystem({
+            usdt: IMockUsdt(address(usdt)),
+            iouToken: IIouToken(address(iou)),
+            memberRegistry: IMemberRegistry(address(memberRegistry)),
+            reservePool: IReservePool(address(pool)),
+            insuranceFund: IInsuranceFund(address(fund)),
+            sarrafRegistry: ISarrafRegistry(address(sarrafRegistry)),
+            noteVault: INoteVault(address(vault))
+        });
+    }
+}
