{
  "name": "@dovizir/notes",
  "version": "0.1.0",
  "description": "Dovizir offline-note library (M1, arm A): carving, spend transcripts, offline verification, reconciliation, cert chains. Pure logic - no I/O, no chain access.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/curves": "^1.9.6",
    "@noble/hashes": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
